import { Theme } from "theme.slint";

export struct MessageItem {
    message_id: string,
    sender_id: string,
    sender_name: string,
    content: string,
    timestamp: string,
    is_own: bool,
    edited: bool,
    reply_to: string,
}

export struct DmConversationItem {
    dm_id: string,
    other_user_id: string,
    other_nickname: string,
    e2ee_enabled: bool,
    messages: [MessageItem],
}

export struct MemberItem {
    user_id: string,
    nickname: string,
    status: string,
}

export component ChatPanel {
    in-out property <string> active-channel-id;
    in-out property <string> active-channel-name;
    in-out property <[MessageItem]> messages;
    in-out property <[MemberItem]> members;
    in-out property <string> input-text;
    in-out property <bool> is-dm;
    in-out property <bool> e2ee-enabled;
    in-out property <string> dm-partner-name;

    callback send-message(string, string);
    callback load-more(string);

    VerticalLayout {
        padding: 0;
        spacing: 0;

        Rectangle {
            height: 48px;
            background: Theme.bg-surface;
            HorizontalLayout {
                padding: 8px;
                spacing: 4px;
                Text {
                    text: e2ee-enabled ? "🔒 " : "";
                    color: Theme.accent;
                }
                Text {
                    text: is-dm ? dm-partner-name : "#" + active-channel-name;
                    color: Theme.text-primary;
                    font-size: 16px;
                }
            }
        }

        Flickable {
            VerticalLayout {
                for msg in messages: Rectangle {
                    height: 60px;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: msg.sender_name;
                                color: Theme.accent;
                                font-weight: 700;
                            }
                            Text {
                                text: msg.timestamp;
                                color: Theme.text-muted;
                                font-size: 11px;
                            }
                        }
                        Text {
                            text: msg.content;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 48px;
            background: Theme.bg-surface;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                TextInput {
                    text <=> input-text;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 64px;
                    height: 32px;
                    background: Theme.accent;
                    border-radius: Theme.radius;
                    TouchArea {
                        clicked => {
                            send-message(active-channel-id, input-text);
                            input-text = "";
                        }
                    }
                    Text {
                        text: "Send";
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
