export global Theme {
    in-out property <color> bg-base: #181825;
    in-out property <color> bg-surface: #1e1e2e;
    in-out property <color> bg-hover: #2a2a3e;
    in-out property <color> bg-elevated: #2a2a3e;
    in-out property <color> bg-interactive: #313244;
    in-out property <color> accent: #E67E22;
    in-out property <color> text-primary: #cdd6f4;
    in-out property <color> text-secondary: #a0a4b8;
    in-out property <color> text-muted: #6c7086;
    in-out property <color> text-disabled: #45475a;
    in-out property <color> danger: #f38ba8;
    in-out property <color> success: #a6e3a1;
    in-out property <length> radius: 8px;
}
