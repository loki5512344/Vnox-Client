import { Theme } from "theme.slint";

export struct VoiceMemberItem {
    user_id: string,
    nickname: string,
    speaking: bool,
}

export component VoicePanel {
    in-out property <[VoiceMemberItem]> members;
    in-out property <bool> mic-enabled;
    in-out property <bool> deafened;
    in-out property <string> channel-name;
    in-out property <string> activity-banner;

    callback toggle-mic();
    callback toggle-deafen();
    callback leave-voice();

    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "🔊 " + channel-name;
            color: Theme.text-primary;
        }
        Text {
            text: activity-banner;
            color: Theme.text-muted;
        }
        Flickable {
            VerticalLayout {
                for m in members: Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 12px;
                            height: 12px;
                            border-radius: 6px;
                            background: m.speaking ? Theme.success : Theme.text-muted;
                        }
                        Text {
                            text: m.nickname;
                            color: Theme.text-primary;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                height: 32px;
                background: Theme.accent;
                border-radius: Theme.radius;
                TouchArea {
                    clicked => { toggle-mic(); }
                }
                Text {
                    text: mic-enabled ? "Mute" : "Unmute";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 32px;
                background: Theme.accent;
                border-radius: Theme.radius;
                TouchArea {
                    clicked => { toggle-deafen(); }
                }
                Text {
                    text: deafened ? "Undeafen" : "Deafen";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 32px;
                background: Theme.danger;
                border-radius: Theme.radius;
                TouchArea {
                    clicked => { leave-voice(); }
                }
                Text {
                    text: "Leave";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
